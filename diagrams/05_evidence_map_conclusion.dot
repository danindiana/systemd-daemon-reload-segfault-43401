digraph EvidenceMap {
    rankdir=TB;
    bgcolor="#0d0d0d";
    fontname="Courier";
    label="Case status: systemd/systemd #43401";
    labelloc=t;
    fontsize=20;
    fontcolor="#00ff9f";

    node [shape=box, style=filled, fillcolor="#1a1a2e", color="#00ff9f", fontname="Courier", fontcolor="#e0e0e0", penwidth=2];
    edge [penwidth=2, fontname="Courier", fontcolor="#ffcc00", color="#00b4ff"];

    subgraph cluster_confirmed {
        label="CONFIRMED";
        color="#00ff9f"; fontcolor="#00ff9f"; fontname="Courier"; style=bold;
        c1 [label="SIGSEGV inside cescape()\nvia serialize_item_escaped()\n(matches source + backtrace\nfor systemd 249)", fillcolor="#0d2a1a", color="#00ff9f"];
        c2 [label="Crash occurred during\nstate serialization,\nbefore file re-parse stage", fillcolor="#0d2a1a", color="#00ff9f"];
        c3 [label="The malformed PATH= line\nexisted 3 days pre-crash,\nsurvived 4 prior reloads", fillcolor="#0d2a1a", color="#00ff9f"];
        c4 [label="Fixing the line + reload\nnow completes cleanly on\nworlock", fillcolor="#0d2a1a", color="#00ff9f"];
    }

    subgraph cluster_ruledout {
        label="RULED OUT / WEAKENED";
        color="#ff0090"; fontcolor="#ff0090"; fontname="Courier"; style=bold;
        r1 [label="Malformed PATH= text as\nthe literal string cescape()\nescaped and crashed on", fillcolor="#2a0d20", color="#ff0090"];
        r2 [label="Version-specific bug\n(v255 sandbox reproduces\nthe same safe rejection)", fillcolor="#2a0d20", color="#ff0090"];
    }

    subgraph cluster_unknown {
        label="STILL UNKNOWN";
        color="#ff6600"; fontcolor="#ff6600"; fontname="Courier"; style=bold;
        u1 [label="What in-memory state\ncescape() was actually\nescaping at 21:34:37", fillcolor="#3a2200", color="#ff6600"];
        u2 [label="Whether this is a\ngeneral systemd bug class\nor a one-off memory fault", fillcolor="#3a2200", color="#ff6600"];
        u3 [label="Reproduction requires\nheap-state conditions not\nyet identified", fillcolor="#3a2200", color="#ff6600"];
    }

    c3 -> r1 [label="  survived reloads\n  ⇒ unlikely trigger", color="#ff0090", fontcolor="#ff0090"];
    r1 -> u1 [label="  if not this string,\n  then what?", color="#ff6600", fontcolor="#ff6600"];
    c2 -> u1 [color="#ff6600"];
    r2 -> u2 [color="#ff6600"];

    status [shape=note, fillcolor="#2a2a1a", color="#ffcc00", fontcolor="#ffcc00",
        label="Net position: root cause of the SIGSEGV remains\nopen. The malformed unit file was a real bug worth\nfixing on its own merits, but the evidence no longer\nsupports it as the crash trigger. Offered to test\nother malformed-Environment= shapes against v255\nif maintainers have a more specific pattern in mind."];

    legend [shape=note, fillcolor="#1a1a2e", color="#00b4ff", fontcolor="#00b4ff",
        label="Legend: green=confirmed  pink=ruled out/weakened\norange=open question"];
}
